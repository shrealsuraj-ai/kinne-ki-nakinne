rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn(); // Allow without email verification for now since signup doesn't send verification email
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (('email' in request.auth.token) && request.auth.token.email == 'shreal.suraj@gmail.com')
      );
    }

    // --- Validation Blueprints ---

    function isValidProduct(data) {
      return data.keys().hasAll(['sellerId', 'seller', 'title', 'price', 'segment', 'type', 'createdAt']) &&
             data.sellerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.segment is string && data.segment.size() <= 100 &&
             data.type in ['video', 'image', 'slideshow'] &&
             data.createdAt == request.time;
    }

    function isValidBid(data) {
      return data.keys().hasAll(['streamId', 'userId', 'amount', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 &&
             isValidId(data.streamId) &&
             exists(/databases/$(database)/documents/products/$(data.streamId)) &&
             data.timestamp == request.time;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['participants', 'createdAt', 'updatedAt']) &&
             data.participants is list && data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000 &&
             data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             data.role in ['casual', 'seller', 'admin'];
    }

    // --- Rules ---

    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isEmailVerified() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isEmailVerified() && (
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['views']) && incoming().views == existing().views + 1) ||
        (isOwner(existing().sellerId) && 
         incoming().sellerId == existing().sellerId &&
         incoming().createdAt == existing().createdAt &&
         // Action: Basic Update
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'shortHeadline', 'brand', 'category', 'tags', 'description', 'longDescription', 'keyFeatures', 'specifications', 'price', 'discount', 'stock', 'shippingInfo', 'returnPolicy', 'searchMetadata', 'url', 'mediaUrls', 'uploadStatus', 'views', 'type']))
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().sellerId));

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /seller_reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (isAdmin() || existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /bids/{bidId} {
      allow get: if isValidId(bidId);
      allow list: if true; // Auctions are public
      allow create: if isEmailVerified() && isValidBid(incoming()) && isValidId(bidId);
      allow delete: if isAdmin();
    }

    match /group_deals/{dealId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /group_members/{memberId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isEmailVerified() && isValidConversation(incoming()) && isValidId(conversationId);
      allow update: if isSignedIn() && request.auth.uid in existing().participants &&
                    incoming().participants == existing().participants &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasAny(['lastMessage', 'lastMessageTime', 'lastMessageSenderId', 'unreadCount', 'updatedAt']);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isEmailVerified() && isValidMessage(incoming()) && isValidId(messageId) &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /seller_applications/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /sellers/{userId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin() || isOwner(userId);
    }

    match /casual_users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow write: if isAdmin() || (isOwner(userId) && incoming().role == existing().role);
    }

    match /commission_audits/{auditId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /platform_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
